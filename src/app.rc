#include <windows.h>
#include "resource.h"

#pragma code_page(65001)

LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL
IDI_APP_ICON ICON "app.ico"
1 RT_MANIFEST "app.manifest"

LANGUAGE LANG_KOREAN, SUBLANG_KOREAN
VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,4,0,0
 PRODUCTVERSION 1,4,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041204b0"
        BEGIN
            VALUE "CompanyName", "OneTimePE Utility"
            VALUE "FileDescription", "1회성 내장 WinPE & 원격지원 매니저 (OneTimePE v1.4)"
            VALUE "FileVersion", "1.4.0.0"
            VALUE "InternalName", "OneTimePE.exe"
            VALUE "OriginalFilename", "OneTimePE.exe"
            VALUE "ProductName", "OneTimePE Boot Manager"
            VALUE "ProductVersion", "1.4.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x412, 1200
    END
END

